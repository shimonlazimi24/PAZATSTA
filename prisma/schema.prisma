generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  teacher
  parent
  student
}

enum LessonStatus {
  pending_approval
  scheduled
  completed
  canceled
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  role      Role
  createdAt DateTime @default(now())

  sessions          Session[]
  teacherProfile    TeacherProfile?
  studentProfile    StudentProfile?
  lessonsAsTeacher  Lesson[]        @relation("LessonTeacher")
  lessonsAsStudent  Lesson[]        @relation("LessonStudent")
  availabilitySlots Availability[]
  workshopsLed      Workshop[]

  @@index([role])
}

model TeacherProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String?
  bio             String?
  profileImageUrl String? // deprecated - use avatarType
  avatarType      String? // "male" | "female" - generic avatar
  specialization  String? // legacy single string
  specialties     String[] @default([]) // multi-select, must match booking topic labels exactly
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  studentFullName        String?
  parentFullName         String?
  parentPhone            String?
  parentEmail            String?
  currentScreeningType   String? // selected topic
  currentScreeningDate   DateTime?
  followUpReminderSentAt DateTime? // reminder tracking
  createdAt              DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentScreeningDate])
}

model Availability {
  id        String   @id @default(cuid())
  teacherId String
  date      DateTime
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date, startTime])
  @@index([teacherId, date])
}

// TODO (time consistency): Consider startsAt/endsAt DateTime (UTC) instead of date + startTime/endTime
// to avoid timezone bugs. Would require migration and API/UI updates.
model Lesson {
  id                  String       @id @default(cuid())
  teacherId           String
  studentId           String
  date                DateTime
  startTime           String
  endTime             String
  topic               String? // סוג מיון/מסלול שנבחר בהזמנה
  status              LessonStatus @default(pending_approval)
  approvalExpiresAt   DateTime?
  approvedByTeacherAt DateTime?
  approvedByAdminAt   DateTime?
  reportCompleted     Boolean      @default(false)
  followUpCompletedAt DateTime?
  questionFromStudent String?
  createdAt           DateTime     @default(now())
  /// Set when 24h-before reminder email was sent to student + parent (cron).
  reminder24hSentAt   DateTime?
  /// When the lesson became canceled (cancel, reject, expiry, not held). Null on older rows.
  canceledAt          DateTime?

  teacher           User               @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student           User               @relation("LessonStudent", fields: [studentId], references: [id], onDelete: Cascade)
  summary           LessonSummary?
  approvalReminders ApprovalReminder[]

  workshopId String?
  workshop   Workshop? @relation(fields: [workshopId], references: [id], onDelete: SetNull)

  // Partial unique indexes live in SQL migrations (Prisma cannot express a WHERE
  // clause on @@unique):
  //   Lesson_teacher_date_start_when_no_workshop — one private lesson per slot
  //   Lesson_workshop_student_when_live          — one live signup per workshop

  @@index([teacherId, date])
  @@index([teacherId, status, date])
  @@index([studentId, date])
  @@index([status])
  @@index([status, approvalExpiresAt])
  @@index([approvalExpiresAt])
  @@index([date, status])
  @@index([workshopId])
}

/// Group workshop / סדנה — multiple students can share the same calendar slot (see partial unique on Lesson).
model Workshop {
  id                 String   @id @default(cuid())
  name               String
  date               DateTime
  teacherId          String
  maxParticipants    Int
  startTime          String   @default("09:00")
  endTime            String   @default("17:00")
  /// Shown as סוג מיון; must match TeacherProfile.specialties entry
  topicLabel         String   @unique
  /// Optional admin-facing / public description (הסבר כללי)
  generalDescription String?
  createdAt          DateTime @default(now())

  teacher User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([teacherId, date])
}

model LessonSummary {
  id              String   @id @default(cuid())
  lessonId        String   @unique
  summaryText     String   @default("") // סיכום כללי (generalSummary)
  homeworkText    String   @default("")
  pointsToKeep    String   @default("") // נקודות לשימור (preservationPoints)
  pointsToImprove String   @default("") // נקודות לשיפור (improvementPoints)
  /// Comma-separated Tip.slug values the teacher selected. A record of the choice.
  tips            String   @default("")
  /// Free text the teacher added alongside the selected tips.
  tipsCustom      String   @default("")
  /// Tip text resolved at completion and frozen. Editing a Tip afterwards must not
  /// change a report a parent already received, so rendering prefers this over
  /// re-resolving `tips`. Empty on rows written before this column existed.
  tipsSnapshot    String   @default("")
  recommendations String   @default("") // המלצות להמשך (nextRecommendations)
  pdfUrl          String?
  createdAt       DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

/// A reusable tip the teacher can attach to a lesson summary. Managed by the admin.
model Tip {
  id         String   @id @default(cuid())
  /// Stable identifier carried in historical LessonSummary.tips values. Never reuse.
  slug       String   @unique
  label      String
  text       String
  /// Display-only heading in the teacher's picker, e.g. "צו ראשון - דפר".
  groupLabel String   @default("")
  /// Normalized topic keys (see normalizeTopicKey) this tip applies to.
  /// Empty = general, offered for every lesson.
  topics     String[] @default([])
  sortOrder  Int      @default(0)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isArchived, sortOrder])
}

/// Wording for one field of the lesson summary form, as the teacher sees it while
/// writing. It deliberately does NOT drive the PDF headings: PDFs re-render from
/// the database on every view, so a renamed label would rewrite reports parents
/// already received.
///
/// One row per LessonSummary column; the set of fields is fixed, so `key` is the
/// primary key and rows are only ever updated, never created or deleted.
model ReportFieldConfig {
  key         String   @id
  label       String
  helpText    String   @default("")
  placeholder String   @default("")
  isRequired  Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model PublicPdfLink {
  id             String    @id @default(uuid())
  tokenHash      String    @unique
  lessonId       String?
  pdfId          String?
  recipientEmail String?
  isRevoked      Boolean   @default(false)
  /// Links carry a minor's lesson report; they must not stay valid forever.
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  lastAccessedAt DateTime?
  accessCount    Int       @default(0)

  @@index([tokenHash])
  @@index([lessonId, recipientEmail])
  @@index([expiresAt])
}

model Invite {
  id        String    @id @default(cuid())
  email     String
  role      Role
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model OtpRequest {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  /// Random 32-byte secret carried in the cookie. Never the row id.
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One reminder sent to a teacher about a lesson request they have not approved yet.
/// The unique key makes a reminder impossible to send twice, even if two cron runs overlap.
model ApprovalReminder {
  id        String   @id @default(cuid())
  lessonId  String
  teacherId String
  /// Hours left in the approval window when this reminder was due (18, 12).
  mark      Int
  /// "email" now; "sms" once SMS is connected.
  channel   String
  sentAt    DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, mark, channel])
  @@index([teacherId, sentAt])
  @@index([sentAt])
}

/// A kind of group lesson, managed by the admin: a category ("יום המאה", "צו ראשון") and a sub-type.
model GroupLessonType {
  id        String   @id @default(cuid())
  category  String
  name      String
  sortOrder Int      @default(0)
  /// Hidden from new lessons when false; existing lessons keep it.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  lessons GroupLesson[]

  @@unique([category, name])
}

/// A group lesson the admin schedules and teachers sign up to lead.
model GroupLesson {
  id             String   @id @default(cuid())
  typeId         String
  /// UTC midnight of the Israeli calendar date, like Lesson.date.
  date           DateTime
  startTime      String
  endTime        String
  location       String?
  details        String?
  teachersNeeded Int      @default(1)
  /// "open" | "canceled"
  status         String   @default("open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  type    GroupLessonType     @relation(fields: [typeId], references: [id])
  signups GroupLessonSignup[]
  reports GroupLessonReport[]

  @@index([date])
  @@index([status, date])
}

/// A teacher signed up to lead a group lesson.
model GroupLessonSignup {
  id             String    @id @default(cuid())
  groupLessonId  String
  teacherId      String
  createdAt      DateTime  @default(now())
  /// Set when the day-before reminder went out.
  reminderSentAt DateTime?

  groupLesson GroupLesson @relation(fields: [groupLessonId], references: [id], onDelete: Cascade)

  @@unique([groupLessonId, teacherId])
  @@index([teacherId])
}

/// The teacher's report after a group lesson. Frozen once submitted.
model GroupLessonReport {
  id            String   @id @default(cuid())
  groupLessonId String
  teacherId     String
  /// The lesson type as the teacher reported it, stored as text so later renames do not change it.
  typeLabel     String
  participants  Int
  notes         String   @default("")
  submittedAt   DateTime @default(now())

  groupLesson GroupLesson @relation(fields: [groupLessonId], references: [id], onDelete: Cascade)

  @@unique([groupLessonId, teacherId])
}

/// Monthly announcements already sent, so each goes out once ("2026-12" + "signup_open").
model GroupLessonNotice {
  id       String   @id @default(cuid())
  monthKey String
  kind     String
  sentAt   DateTime @default(now())

  @@unique([monthKey, kind])
}

/// A frontal study day ("יום פרונטלי") at a school or venue, managed like a folder by the admin.
model FrontalDay {
  id               String    @id @default(cuid())
  title            String
  /// UTC midnight of the Israeli calendar date.
  date             DateTime
  startTime        String
  endTime          String
  address          String
  topic            String    @default("")
  presentationUrl  String    @default("")
  contactName      String    @default("")
  contactPhone     String    @default("")
  whatsappUrl      String    @default("")
  feedbackUrl      String    @default("")
  /// Access code for the gift course, if the day includes one.
  courseCode       String    @default("")
  courseUrl        String    @default("")
  /// Who receives the approved closing report (school / venue).
  recipientName    String    @default("")
  recipientEmail   String    @default("")
  teachersNeeded   Int       @default(1)
  /// How many students are expected, so the survey can show "23 of 30 answered".
  classSize        Int?
  /// Message teachers get when they register, with {placeholders}.
  messageTemplate  String    @default("")
  /// Reminder teachers get before the day, with {placeholders}.
  reminderTemplate String    @default("")
  /// Items each teacher ticks off before the day.
  checklist        String[]  @default([])
  /// "open" | "canceled"
  status           String    @default("open")
  /// Set when the admin was warned the day has no teachers two weeks ahead.
  noTeacherAlertAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  signups         FrontalDaySignup[]
  report          FrontalDayReport?
  surveyResponses FrontalSurveyResponse[]

  @@index([date])
  @@index([status, date])
}

model FrontalDaySignup {
  id             String    @id @default(cuid())
  dayId          String
  teacherId      String
  /// Checklist items this teacher has ticked, by text.
  checklistDone  String[]  @default([])
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  day FrontalDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId, teacherId])
  @@index([teacherId])
}

/// The closing report for a day: a teacher fills it, the admin approves it, then it is sent to the recipient.
model FrontalDayReport {
  id                String    @id @default(cuid())
  dayId             String    @unique
  teacherId         String
  /// [{ label, value }] — labels copied from the template at submission so later edits do not change it.
  answers           Json
  /// "submitted" | "returned" | "approved"
  status            String    @default("submitted")
  adminNote         String    @default("")
  submittedAt       DateTime  @default(now())
  approvedAt        DateTime?
  sentToRecipientAt DateTime?

  day FrontalDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

/// The closing-report fields, defined by the admin.
model FrontalReportField {
  id            String   @id @default(cuid())
  label         String
  /// "short" | "long" | "number" | "date" | "choice" (one option) | "multi" (several options)
  kind          String   @default("long")
  required      Boolean  @default(true)
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  /// Small hint under the label.
  help          String   @default("")
  /// Options for "choice" and "multi".
  options       String[] @default([])
  /// Shown only when this other field's answer is (or, for "multi", includes) one of showIfValues.
  showIfFieldId String?
  showIfValues  String[] @default([])
  /// Kept for Pazatsta only: never sent to the school with the approved report.
  internal      Boolean  @default(false)
  /// "report" (the teacher's closing report) | "survey" (the students' feedback survey).
  form          String   @default("report")

  @@index([form, active])
}

/// One student's answers to a frontal day's feedback survey. No login: the
/// browser gets a random key in a cookie so the same phone counts only once.
model FrontalSurveyResponse {
  id        String   @id @default(cuid())
  dayId     String
  clientKey String
  /// [{ label, value }] — labels copied at submission so later edits do not change it.
  answers   Json
  createdAt DateTime @default(now())

  day FrontalDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId, clientKey])
  @@index([dayId])
}

/// Small admin-editable settings (default templates and checklist), one row per key.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
